# Port the room server listens on.
PORT=2567

# A trip is a few friends who already know each other.
MAX_CLIENTS_PER_ROOM=8

# Metres per second a player may cover before a move is rejected as a teleport.
# The walker's fastest gait is 4.5 m/s and its fast travel is 14 m/s, so this is
# headroom for a late packet rather than a limit anyone walks into.
MAX_SPEED=34
